{
  "rules": {
    "users": {
      "$userId": {
        // Anyone authenticated can read their own user profile. Admins can read all.
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        // Anyone can create their initial profile. Admins can update all.
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "userSessions": {
      // Admins can read all sessions. Users can read their own sessions.
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$sessionId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && (data.child('userId').val() === auth.uid || !data.exists() || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "rolePermissions": {
      // Anyone authenticated can read permissions to check what they can do
      ".read": "auth != null",
      // Only super_admin can modify permissions
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
    },
    "activityLogs": {
      // Only admins can read activity logs
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      // Anyone authenticated can write an activity log
      ".write": "auth != null"
    }
  }
}
