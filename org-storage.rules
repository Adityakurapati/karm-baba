rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Organization Logos
    match /organizationLogos/{orgId}/{fileName} {
      // Anyone can read a logo
      allow read: if true;
      // Only authenticated users can upload (could be locked to org members with custom claims)
      allow write: if request.auth != null 
                   && request.resource.size < 2 * 1024 * 1024 // 2MB max
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Organization Documents
    match /organizationDocuments/{orgId}/{docType}/{fileName} {
      // Only authenticated users can read/write their org docs
      allow read, write: if request.auth != null;
    }
    
  }
}
